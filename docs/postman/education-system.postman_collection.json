              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "  const type = json.data.user.userType;",
                  "  const key = type === 'student' ? 'studentToken' : type === 'teacher' ? 'teacherToken' : 'adminToken';",
                  "  pm.collectionVariables.set(key, json.data.token);",
                  "  if (json.data.user.userType === 'teacher') pm.collectionVariables.set('teacherTokenRaw', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
