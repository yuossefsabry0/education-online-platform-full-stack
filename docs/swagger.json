{
  "openapi": "3.0.0",
  "info": {
    "title": "Education System API",
    "version": "1.0.0",
    "description": "Backend API for the Education System project. All responses use the wrapper `{ success, data, error }`. Success: `success: true`, `data: <payload>`, `error: null`. Failure: `success: false`, `data: null`, `error: { code, message, details }`."
  },
  "servers": [
    { "url": "{{BASE_URL}}/api", "description": "Uses the BASE_URL Postman variable (local/staging/production)" },
    { "url": "http://localhost:5000/api", "description": "Local development" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Contact" },
    { "name": "Teachers" },
    { "name": "User" },
    { "name": "Subscriptions" },
    { "name": "Content" },
    { "name": "Teacher Dashboard" },
    { "name": "Admin" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Success": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object", "nullable": true },
          "error": { "type": "null", "example": null }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "data": { "type": "null", "example": null },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object", "nullable": true }
            }
          }
        }
      },
      "RegisterStudent": {
        "type": "object",
        "required": ["name", "username", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "username": { "type": "string", "example": "john_doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "format": "password", "minLength": 6 }
        }
      },
      "Login": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "userType": {
            "type": "string",
            "enum": ["student", "teacher", "admin"],
            "description": "Optional. When omitted, the server resolves the account by username; required only when the username exists in more than one account table."
          }
        }
      },
      "RefreshToken": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "ChangePassword": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 6, "maxLength": 128 }
        }
      },
      "ResetRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "userType": { "type": "string", "enum": ["student", "teacher", "admin"] }
        }
      },
      "ResetConfirm": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 6, "maxLength": 128 }
        }
      },
      "VerifyResend": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "userType": { "type": "string", "enum": ["student", "teacher", "admin"] }
        }
      },
      "VerifyConfirm": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": { "type": "string" }
        }
      },
      "ConfirmPayment": {
        "type": "object",
        "required": ["teacherId", "duration"],
        "properties": {
          "teacherId": { "type": "integer", "example": 1 },
          "duration": {
            "type": "string",
            "enum": ["ONE_MONTH", "THREE_MONTHS", "SIX_MONTHS", "ONE_YEAR"]
          }
        }
      },
      "AddTeacher": {
        "type": "object",
        "required": ["name", "username", "email", "password", "subject", "gradeClass", "price1Month", "price3Months", "price6Months", "price1Year"],
        "properties": {
          "name": { "type": "string", "example": "New Teacher" },
          "username": { "type": "string", "example": "new_teacher" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 6 },
          "subject": { "type": "string", "example": "Math" },
          "gradeClass": { "type": "string", "example": "2nd year secondary grade" },
          "price1Month": { "type": "number", "example": 60 },
          "price3Months": { "type": "number", "example": 162 },
          "price6Months": { "type": "number", "example": 300 },
          "price1Year": { "type": "number", "example": 540 }
        }
      },
      "EditTeacher": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 6 },
          "subject": { "type": "string" },
          "gradeClass": { "type": "string" },
          "price1Month": { "type": "number" },
          "price3Months": { "type": "number" },
          "price6Months": { "type": "number" },
          "price1Year": { "type": "number" }
        }
      },
      "AddContent": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": { "type": "string", "enum": ["LECTURE", "LESSON_CONTENT", "HOMEWORK"] },
          "title": { "type": "string", "example": "Algebra basics" },
          "body": { "type": "string", "nullable": true },
          "fileUrl": { "type": "string", "nullable": true },
          "isPublished": { "type": "boolean", "default": true }
        }
      },
      "EditContent": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["LECTURE", "LESSON_CONTENT", "HOMEWORK"] },
          "title": { "type": "string" },
          "body": { "type": "string", "nullable": true },
          "fileUrl": { "type": "string", "nullable": true },
          "isPublished": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new student (strict rate limited)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterStudent" } } }
        },
        "responses": {
          "201": { "description": "Student created" },
          "400": { "description": "Validation failed" },
          "409": { "description": "Username/email already in use" },
          "429": { "description": "Too many requests" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login for students, teachers and admin (strict rate limited)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } }
        },
        "responses": {
          "200": {
            "description": "Returns access token, refresh token and profile"
          },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid credentials" },
          "404": { "description": "Teacher account is inactive" },
          "409": { "description": "Username exists in more than one account table; resubmit with userType" },
          "429": { "description": "Too many attempts" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new access token (rotates the refresh cookie)",
        "description": "Reads the httpOnly refresh cookie (SameSite=Lax, Secure in production over HTTPS). With the explicit CORS allowlist and SameSite set, no separate CSRF token is introduced. Successful refresh rotates the refresh token: a new cookie value is issued and the old value is revoked; reuse of a revoked value is rejected and revokes its token family.",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshToken" } } }
        },
        "responses": {
          "200": { "description": "New access token" },
          "400": { "description": "Missing refresh token" },
          "401": { "description": "Invalid/revoked/expired token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke a refresh token and clear the refresh cookie",
        "description": "Reads the httpOnly refresh cookie when present; revokes the matching database row and clears the cookie.",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshToken" } } }
        },
        "responses": {
          "200": { "description": "Logged out" },
          "400": { "description": "Invalid or already revoked" }
        }
      }
    },
    "/auth/password": {
      "put": {
        "tags": ["Auth"],
        "summary": "Change own password (students, teachers, admins)",
        "description": "Requires the current password. On success revokes ALL refresh tokens of the user and clears the refresh cookie; the client must log in again.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePassword" } } }
        },
        "responses": {
          "200": { "description": "Password changed" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Unauthenticated or wrong current password" }
        }
      }
    },
    "/auth/password-reset/request": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a password-reset token",
        "description": "Always returns the same generic message whether or not the email exists (no account enumeration). A single-use token valid for 1 hour is emailed when exactly one account matches; prior pending tokens are invalidated.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetRequest" } } }
        },
        "responses": {
          "200": { "description": "Generic acknowledgement" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/auth/password-reset/confirm": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password with a single-use token",
        "description": "Consumes the token (reuse rejected), updates the password and revokes ALL refresh tokens of the user.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetConfirm" } } }
        },
        "responses": {
          "200": { "description": "Password reset" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid or expired reset token" }
        }
      }
    },
    "/auth/verify-email/resend": {
      "post": {
        "tags": ["Auth"],
        "summary": "Resend an email-verification token",
        "description": "Rate limited to 5 requests per hour per IP. Always returns the same generic message (no enumeration). A new token valid for 24 hours invalidates prior pending tokens. Verification never blocks login.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyResend" } } }
        },
        "responses": {
          "200": { "description": "Generic acknowledgement" },
          "400": { "description": "Validation failed" },
          "429": { "description": "Too many requests" }
        }
      }
    },
    "/auth/verify-email/confirm": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify an email with a single-use token",
        "description": "Marks the owning account verified (idempotent success for already-verified accounts) and consumes the token.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyConfirm" } } }
        },
        "responses": {
          "200": { "description": "Email verified" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid or expired verification token" }
        }
      }
    },
    "/contact": {
      "get": {
        "tags": ["Contact"],
        "summary": "Contact information",
        "description": "Returns the CONTACT_EMAIL environment value (development default only; production must set a real address).",
        "responses": {
          "200": { "description": "Contact email" }
        }
      }
    },
    "/teachers": {
      "get": {
        "tags": ["Teachers"],
        "summary": "List teachers (public sees limited fields; admin sees full data with prices)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 }, "description": "Items per page" },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["id", "name", "subject", "gradeClass", "username", "email", "createdAt", "updatedAt"] } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } }
        ],
        "responses": { "200": { "description": "Paginated teacher list" } }
      }
    },
    "/teachers/search": {
      "get": {
        "tags": ["Teachers"],
        "summary": "Search teachers by name (with fuzzy fallback)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string" } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Paginated search results" } }
      }
    },
    "/teachers/{teacherId}/content": {
      "get": {
        "tags": ["Teachers"],
        "summary": "Published content of a teacher (requires active subscription to that teacher)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "teacherId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Content list" },
          "403": { "description": "No active subscription for this teacher" }
        }
      }
    },
    "/user/me": {
      "get": {
        "tags": ["User"],
        "summary": "Current user profile plus their active subscription roles",
        "description": "Returns { user, activeRoles, teachers }. activeRoles is unchanged (raw SUB{id} role strings). teachers is an additive detail array resolving each active role to { id, name, subject, gradeClass }; empty for non-students.",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Profile and activeRoles" } }
      }
    },
    "/user/history": {
      "get": {
        "tags": ["User"],
        "summary": "Own subscription and activity history (student only)",
        "description": "Returns { subscriptions: { items, pagination }, events: { items, pagination } }. Subscription items expose id, duration, price, startDate, endDate, status, teacherRole and teacher { id, name, subject }. Events expose id, actionType, targetId, timestamp and details. No other users' data is included.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number (default 1)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "description": "Items per page (default 10, max 50)" }
        ],
        "responses": {
          "200": { "description": "Paginated own history" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Students only" }
        }
      }
    },
    "/subscriptions/mine": {
      "get": {
        "tags": ["Subscriptions"],
        "summary": "Calling student's active subscriptions with teacher details (student only)",
        "description": "Returns { subscriptions: [{ id, duration, startDate, endDate, status, teacher: { id, name, subject, gradeClass } }] }. Only subscriptions satisfying the active rule (status not EXPIRED/CANCELLED and endDate in the future) are returned. Subscriptions whose teacher was soft-deleted (isActive false) are excluded from the default list; history is preserved in the database.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Active subscriptions, empty array when none" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Only students can view subscriptions" }
        }
      }
    },
    "/subscriptions/teacher/{teacherId}": {
      "get": {
        "tags": ["Subscriptions"],
        "summary": "Subscription plans/prices for one teacher (student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "teacherId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Plans and active subscription info" } }
      }
    },
    "/subscriptions/confirm-payment": {
      "post": {
        "tags": ["Subscriptions"],
        "summary": "Confirm payment and activate a subscription (student only)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfirmPayment" } } }
        },
        "responses": {
          "201": { "description": "Subscription activated" },
          "403": { "description": "Not a student" },
          "404": { "description": "Teacher not found" },
          "409": { "description": "Already has an active subscription" }
        }
      }
    },
    "/subscriptions/{subscriptionId}/cancel": {
      "post": {
        "tags": ["Subscriptions"],
        "summary": "Cancel own subscription (student only; history preserved)",
        "description": "Only the owning student may cancel. Valid transition ACTIVE to CANCELLED; other states return 409. A cancellation notification is recorded exactly once.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "subscriptionId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Subscription cancelled" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Not the owning student" },
          "404": { "description": "Not found" },
          "409": { "description": "Not active" }
        }
      }
    },
    "/content/teacher/{teacherId}": {
      "get": {
        "tags": ["Content"],
        "summary": "Teacher content page (requires active subscription role SUB{teacherId})",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "teacherId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Content page with sections" },
          "403": { "description": "Subscription required" }
        }
      }
    },
    "/content/teacher/{teacherId}/{section}": {
      "get": {
        "tags": ["Content"],
        "summary": "One content section (lectures | lesson-content | homework)",
        "description": "Paginated list ordered by createdAt ASC. Omitting page/limit returns page 1 with limit 10. q filters titles (case-insensitive contains). Response keeps section content and adds a pagination envelope.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "teacherId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "section", "in": "path", "required": true, "schema": { "type": "string", "enum": ["lectures", "lesson-content", "homework"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number (default 1)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "description": "Items per page (default 10, max 50)" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Title search text" }
        ],
        "responses": {
          "200": { "description": "Section content with pagination" },
          "400": { "description": "Invalid page/limit" },
          "404": { "description": "Unknown section" }
        }
      }
    },
    "/files/{name}": {
      "get": {
        "tags": ["Content"],
        "summary": "Download an uploaded file by generated name",
        "description": "Authorization matches the owning content gates: admins allow, owning teachers allow, students require an active subscription to the owning teacher's published content.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "File bytes with the stored content type" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Access denied" },
          "404": { "description": "File not found" }
        }
      }
    },
    "/teacher/dashboard": {
      "get": {
        "tags": ["Teacher Dashboard"],
        "summary": "Teacher's own dashboard with their content (teacher role)",
        "description": "Content list ordered by createdAt ASC with page/limit/q support (defaults page 1, limit 10, max 50) and a pagination envelope; the paginated items are grouped into sections. q filters titles (case-insensitive contains).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number (default 1)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "description": "Items per page (default 10, max 50)" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Title search text" }
        ],
        "responses": { "200": { "description": "Dashboard" } }
      }
    },
    "/teacher/dashboard/subscribers": {
      "get": {
        "tags": ["Teacher Dashboard"],
        "summary": "List of subscribers for the logged-in teacher (teacher role)",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Subscribers" } }
      }
    },
    "/teacher/dashboard/income": {
      "get": {
        "tags": ["Teacher Dashboard"],
        "summary": "Income for this month, last 3 months and year (teacher role)",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Income summary" } }
      }
    },
    "/teacher/dashboard/content": {
      "post": {
        "tags": ["Teacher Dashboard"],
        "summary": "Add content as a teacher (teacher role)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddContent" } } }
        },
        "responses": { "201": { "description": "Content created" } }
      }
    },
    "/teacher/dashboard/content/upload": {
      "post": {
        "tags": ["Teacher Dashboard"],
        "summary": "Upload a file for own content (teacher role)",
        "description": "Multipart form with a single 'file' field. Allowed types: png, jpg/jpeg, webp, gif, pdf, mp4; max 10MB; stored under a generated random name. Returns { fileUrl, fileName, mimeType, size } where fileUrl is a same-origin /api/files/<name> path.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } } } }
        },
        "responses": {
          "201": { "description": "File stored" },
          "400": { "description": "Unsupported type or missing file" },
          "413": { "description": "File too large" }
        }
      }
    },
    "/teacher/dashboard/content/{contentId}": {
      "put": {
        "tags": ["Teacher Dashboard"],
        "summary": "Edit own content (teacher role)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "contentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
