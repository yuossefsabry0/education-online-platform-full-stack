    "/admin/logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "In-app Log History (admin only). Note: separate from the server-side developer log file.",
        "description": "Also exposes subscription notification records: SUBSCRIPTION_EXPIRY_NOTIFIED and SUBSCRIPTION_CANCEL_NOTIFIED with details { email, status: sent|failed|skipped }. Expiry notifications are claimed idempotently per subscription and retried on each 60s job pass until sent; cancellations notify once inline with failures recorded; missing recipients are recorded as skipped.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "actionType", "in": "query", "schema": { "type": "string" } },
          { "name": "actorType", "in": "query", "schema": { "type": "string", "enum": ["STUDENT", "TEACHER", "ADMIN", "SYSTEM"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string" } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Paginated logs" } }
      }
    },
