generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionDuration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum TeacherContentType {
  LECTURE
  LESSON_CONTENT
  HOMEWORK
}

enum ActorType {
  STUDENT
  TEACHER
  ADMIN
  SYSTEM
}

enum TokenOwnerType {
  STUDENT
  TEACHER
  ADMIN
}


// Students (regular users) — separate table from Teachers

model Student {
  id            Int            @id @default(autoincrement())
  name          String
  username      String         @unique
  email         String         @unique @db.VarChar(254)
  password      String
  emailVerified Boolean        @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  examAttempts  ExamAttempt[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}


// Teachers — separate table from Students


model Teacher {
  id           Int                @id @default(autoincrement())
  name         String
  username     String             @unique
  email        String             @unique @db.VarChar(254)
  password     String
  subject      String
  gradeClass   String
  // 4 subscription duration prices (stored as data, easy to change per teacher)
  price1Month  Decimal            @db.Decimal(10, 2)
  price3Months Decimal            @db.Decimal(10, 2)
  price6Months Decimal            @db.Decimal(10, 2)
  price1Year   Decimal            @db.Decimal(10, 2)
  // Soft-delete flag (mark deleted/inactive without removing the row)
  isActive     Boolean            @default(true)
  emailVerified Boolean           @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  subscriptions Subscription[]
  contents     TeacherContent[]
  exams        Exam[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([isActive])
}

// Admin — its own separate table (seeded directly, no public route)


model Admin {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique @db.VarChar(254)
  password      String
  emailVerified Boolean        @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}


// Subscriptions — userId + teacherId + price SNAPSHOT + status


model Subscription {
  id         Int                  @id @default(autoincrement())
  studentId  Int
  teacherId  Int
  // Dynamic role identifier derived from the teacher's id (role = "SUB" + teacherId).
  // Not a hardcoded/enum list — adding a teacher automatically yields its role.
  teacherRole String
  duration   SubscriptionDuration
  // Fixed price snapshot recorded at purchase time; never overwritten later.
  price      Decimal              @db.Decimal(10, 2)
  startDate  DateTime
  endDate    DateTime
  status     SubscriptionStatus   @default(ACTIVE)
  expiryNotifiedAt DateTime?
  cancelNotifiedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Fix Task 5: generated VIRTUAL column that evaluates to teacherId when
  // status = 'ACTIVE' and to NULL otherwise. It backs the unique index
  // (studentId, activeSubscriptionKey) that enforces at most one ACTIVE
  // subscription per (student, teacher) pair at the database level (MySQL has
  // no partial/conditional unique indexes). The column is created and managed
  // only by the migration's raw SQL — Prisma treats it via Unsupported so a
  // future `prisma migrate dev` will not see it as drift. Application code
  // never reads or writes this field.
  activeSubscriptionKey Unsupported("int")?

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([studentId, activeSubscriptionKey])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([status, endDate])
  @@index([status, expiryNotifiedAt])
}


// Per-teacher content (Lectures, Lesson Content, Homework)


model TeacherContent {
  id         Int                @id @default(autoincrement())
  teacherId  Int
  type       TeacherContentType
  title      String         @db.VarChar(255)
  body       String?        @db.LongText
  fileUrl    String?        @db.VarChar(500)
  isPublished Boolean           @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  lessonExams Exam[] @relation("ExamLesson")

  @@index([teacherId])
  @@index([type])
  @@index([teacherId, type, isPublished, createdAt])
}


// Refresh Tokens — per-user revocable tokens (student/teacher/admin)


model RefreshToken {
  id        Int            @id @default(autoincrement())
  token     String         @unique @db.VarChar(512)
  ownerType TokenOwnerType
  studentId Int?
  teacherId Int?
  adminId   Int?
  familyId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin   Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ownerType, studentId])
  @@index([ownerType, teacherId])
  @@index([ownerType, adminId])
  @@index([familyId])
  @@index([expiresAt])
}


model PasswordResetToken {
  id        Int            @id @default(autoincrement())
  tokenHash String         @unique @db.VarChar(128)
  ownerType TokenOwnerType
  studentId Int?
  teacherId Int?
  adminId   Int?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin   Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ownerType, studentId])
  @@index([ownerType, teacherId])
  @@index([ownerType, adminId])
  @@index([expiresAt])
}


model EmailVerificationToken {
  id        Int            @id @default(autoincrement())
  tokenHash String         @unique @db.VarChar(128)
  ownerType TokenOwnerType
  studentId Int?
  teacherId Int?
  adminId   Int?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin   Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ownerType, studentId])
  @@index([ownerType, teacherId])
  @@index([ownerType, adminId])
  @@index([expiresAt])
}


// Log History — generic, flexible event log (written by later tasks,
// read/displayed by the admin's Log History route)


model LogHistory {
  id         Int      @id @default(autoincrement())
  actionType String
  // Who performed the action: student/teacher/admin/system (optional row id)
  actorId    String?
  actorType  ActorType
  // The entity the action relates to (teacher id, subscription id, content id, ...)
  targetId   String?
  timestamp  DateTime @default(now())
  // Optional extra context, e.g. JSON
  details    Json?

  @@index([actionType])
  @@index([actorType])
  @@index([targetId])
  @@index([timestamp])
  @@index([actionType, actorType, timestamp])
}


// Exams — created by teachers inside the assignment (homework) workflow.
// Each exam holds multiple-choice questions with a designated correct answer
// and a teacher-defined time limit. An exam may link to one of the teacher's
// own lecture lessons so students can jump back with "Go to Lesson".

model Exam {
  id               Int            @id @default(autoincrement())
  teacherId        Int
  lessonContentId  Int?
  title            String         @db.VarChar(255)
  timeLimitSeconds Int            @default(600)
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  teacher   Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lesson    TeacherContent? @relation("ExamLesson", fields: [lessonContentId], references: [id], onDelete: SetNull)
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([teacherId])
  @@index([teacherId, isPublished, createdAt])
}


model ExamQuestion {
  id           Int    @id @default(autoincrement())
  examId       Int
  text         String @db.VarChar(1000)
  // Multiple-choice options, stored in display order: ["A", "B", "C", "D"]
  options      Json
  // Index into options[] designating the correct answer (set by the teacher)
  correctIndex Int
  position     Int    @default(0)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}


// One graded exam sitting per row: unanswered questions count as incorrect,
// so correct/total/percent fully describe the result.

model ExamAttempt {
  id          Int      @id @default(autoincrement())
  examId      Int
  studentId   Int
  // Chosen option index per question (null = unanswered = incorrect)
  answers     Json
  correct     Int      @default(0)
  total       Int      @default(0)
  percent     Decimal  @db.Decimal(5, 2) @default(0)
  timedOut    Boolean  @default(false)
  submittedAt DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
  @@index([examId, studentId])
}