# ===== Server =====
# The environment the app runs in (development | test | production)
NODE_ENV=development

# The port the Express server listens on
PORT=5000

# Set to false to disable rate limiting (never use in production).
RATE_LIMIT_ENABLED=true

# Comma-separated list of allowed CORS origins. Empty = reflect any origin.
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Database (MySQL) =====
# Full MySQL connection string used by Prisma CLI migrations
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://edu_app:edu_app_2026@127.0.0.1:3306/education_system"

# Individual credentials used by the Prisma driver adapter at runtime
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=edu_app
DATABASE_PASSWORD=edu_app_2026
DATABASE_NAME=education_system

# ===== Test Database (separate from the seeded development DB) =====
# Used only when NODE_ENV=test (Jest integration tests). Keeps test data
# completely isolated from the seeded development/production database.
TEST_DATABASE_URL="mysql://edu_app:edu_app_2026@127.0.0.1:3306/education_system_test"
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=3306
TEST_DATABASE_USER=edu_app
TEST_DATABASE_PASSWORD=edu_app_2026
TEST_DATABASE_NAME=education_system_test

# ===== Authentication / JWT =====
# Secret used to sign access tokens (JWT). MUST be changed in any real environment.
JWT_ACCESS_SECRET=change_me_access_secret

# Secret used to sign refresh tokens (JWT). MUST be changed in any real environment.
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access-token lifetime, e.g. 15m (minutes), 1h, 7d
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh-token lifetime, e.g. 7d
REFRESH_TOKEN_EXPIRES_IN=7d

# Login-token lifetime issued on login (24 hours per spec)
LOGIN_TOKEN_EXPIRES_IN=24h

# ===== Seed script (prisma/seed.js) defaults =====
# Admin credentials inserted by the seed script (there is no public "create admin" route)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@education-system.dev
SEED_ADMIN_PASSWORD=admin123

# Shared password hashed for the seed teachers (dev only)
SEED_TEACHER_PASSWORD=teacher123

# Set to true to also seed one sample student, false to skip
SEED_SAMPLE_STUDENT=true

# Optional sample-student details (used only when SEED_SAMPLE_STUDENT=true)
SEED_STUDENT_NAME=Sample Student
SEED_STUDENT_USERNAME=student1
SEED_STUDENT_EMAIL=student1@education-system.dev
SEED_STUDENT_PASSWORD=student123